{
  "name": "aletheia-extension",
  "version": "1.1.0",
  "description": "Enhanced Aletheia Chrome Extension with enterprise-grade security and performance",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:production": "tsc --sourceMap false",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "security:audit": "npm audit --audit-level moderate",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build:ext": "node build.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chrome-extension",
    "linkedin",
    "ai",
    "typescript",
    "security",
    "performance"
  ],
  "author": "Aletheia Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "security": {
    "audit": {
      "level": "moderate"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  }
}
