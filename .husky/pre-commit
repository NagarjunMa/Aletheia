#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🧹 Pre-commit: formatting and auto-fixing staged files..."
npx lint-staged || { echo "❌ Formatting failed."; exit 1; }

echo "🔍 Pre-commit: running lint..."
make lint || { echo "❌ Lint failed. Fix errors before committing."; exit 1; }

echo "🧩 Pre-commit: running static type check..."
make type-check || { echo "❌ Type checking failed. Fix typescript errors before committing."; exit 1; }

echo "🧪 Pre-commit: running tests..."
make test || { echo "❌ Tests failed. All tests must pass before committing."; exit 1; }

echo "🛡️ Pre-commit: running guardrail tests..."
make guardrails || { echo "❌ Guardrails failed. Security patterns must pass."; exit 1; }

echo "🏗️ Pre-commit: running production build..."
make build || { echo "❌ Build failed. Fix build errors before committing."; exit 1; }

echo "✅ All checks passed."
