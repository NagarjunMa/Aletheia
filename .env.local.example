AWS_S3_BUCKET=your_s3_bucket_name

# Email Services (Optional)
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Development Tools
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# Feature Flags
