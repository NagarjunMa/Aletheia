{
  "name": "aletheia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 | pino-pretty --colorize --translateTime 'HH:MM:ss' --ignore 'pid,hostname'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:guardrails": "vitest --config vitest.guardrails.config.ts",
    "test:guardrails:watch": "vitest --config vitest.guardrails.config.ts --watch",
    "test:guardrails:coverage": "vitest --config vitest.guardrails.config.ts --coverage",
    "test:guardrails:ui": "vitest --config vitest.guardrails.config.ts --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "ANALYZE=true npm run build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:supabase": "tsx scripts/test-supabase-connection.ts",
    "validate": "tsx scripts/startup-validation.ts",
    "health-check": "tsx scripts/startup-validation.ts"
