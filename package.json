{
  "name": "aletheia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "eval:generation": "tsx scripts/evaluate-generation.ts",
    "bench:generation": "tsx scripts/benchmark-generation.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:extension": "node scripts/build-extension-zip.mjs",
    "check:extension-version": "node scripts/check-extension-version.mjs",
    "start": "next start",
    "lint": "eslint app components lib modules proxy.ts next.config.js instrumentation.ts instrumentation-client.ts sentry.edge.config.ts sentry.server.config.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:guardrails": "vitest --config vitest.guardrails.config.ts",
    "test:guardrails:watch": "vitest --config vitest.guardrails.config.ts --watch",
    "test:guardrails:coverage": "vitest --config vitest.guardrails.config.ts --coverage",
    "test:guardrails:ui": "vitest --config vitest.guardrails.config.ts --ui",
    "test:resume-security": "vitest --run lib/resumes app/api/resumes app/api/internal/resumes/cleanup supabase/migrations/resume-upload",
    "test:resume-production": "playwright test e2e/resume-upload.spec.ts",
    "test:candidate-fact-review:ui": "node scripts/test-candidate-fact-review-ui.mjs",
    "test:candidate-fact-review:db": "node scripts/test-candidate-fact-review-db.mjs",
    "audit:resume-logs": "tsx scripts/audit-resume-log-export.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "ANALYZE=true npm run build",
    "security:audit": "npm audit --audit-level high",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:supabase": "tsx scripts/test-supabase-connection.ts",
    "validate": "tsx scripts/startup-validation.ts",
    "health-check": "tsx scripts/startup-validation.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pino": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.68.0",
    "react-intersection-observer": "^10.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "postcss": "$postcss",
    "readdirp": {
      "picomatch": "2.3.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
